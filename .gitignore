# La configuración de cada máquina: se versiona sólo config.example.ini.
pawprints/backend/config/config.ini

# Los registros de la aplicación.
pawprints/backend/logs/*.log

# Los correos que guarda el transporte «archivo» en desarrollo.
pawprints/backend/logs/correos/

# Las tapas que se cargan desde el formulario (se versiona sólo el .gitkeep).
pawprints/frontend/img/tapas/*
!pawprints/frontend/img/tapas/.gitkeep
